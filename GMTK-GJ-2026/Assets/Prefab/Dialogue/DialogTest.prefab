  m_Script: {fileID: 11500000, guid: 1725e93459a727743986bbdd861a2775, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogInteractable
  lines:
  - speaker: 1
    text: HELLO I AM RAT
  - speaker: 1
    text: RAT RAT RAT
  - speaker: 2
    text: you are so cool
  - speaker: 3
    text: I AM COOOL TOO
  - speaker: 0
    text: "G\u030C\u0308i\u0303v\u0355\u0311\u0303\u0313\u0361\u0302\u031C\u0364\u0301\u0300\u036F\u0321\u0346\u0366\u0355\u034E\u0328\u033B\u0338\u036D\u030B\u035E\u0301\u0308\u0320\u034A\u0301\u0359\u0349\u0327\u0305\u034A\u031E\u035A\u0329\u033C\u033A\u036F\u0364\u0349\u032C\u0355\u0301\u0304\u033Ce\u0318\u0315\u031A\u034D\u033F\u035B\u033D\u036A\u033F\u030A\u0359\u0338\u030B\u031F_
      m\u0368\u030B\u0364\u0302\u030F\u0362\u0347\u035B\u036A\u033C\u0366\u035D\u030D\u0347\u0360\u032D\u0329\u033F\u035A\u035F\u0321\u030F\u030C\u0330\u0345\u030F\u0304\u032B\u031F\u0326\u0339\u0337\u0351\u036B\u0318\u0360\u0364\u034D\u0308\u0314\u0354e\u034D\u036E\u0333\u033F\u0326\u032E\u0350\u0306\u036C
      y\u036B\u0338\u0360\u0323o\u030E\u034A\u030D\u0301\u035E\u0304u\u033A\u0323\u030B\u030B\u0330\u0358\u0319\u0338\u0338\u0318\u030C\u0364\u0332\u0347\u0306\u0358\u0369\u033C\u0369\u0314\u0321\u0313\u036Ar\u0358\u0304\u034B\u034A\u030B\u030F\u030E\u0305
      m\u0339\u036F\u0359\u0346\u0336\u032A\u0308\u0301\u0306\u036E\u0326\u0300\u0360\u0318\u031A\u0327\u030Ao\u0326\u0345\u0366\u032E\u036E\u0348\u0321\u031F\u0347\u0367\u035D\u0356\u031F\u034D\u0358\u031Bn\u034E\u0369\u031A\u030F\u0351\u034C\u0361\u0307\u0334\u0312\u033C\u032D\u0317\u0326\u0359\u030B\u030F\u0308\u033B\u0314\u034Ce\u0310\u034C\u035A\u0312\u0342\u0350\u0327\u036B\u031F\u0321\u0304\u033A\u0354\u0306_\u0348\u033D\u0353\u034Cy\u0302\u0327\u0301\u0300\u0367\u0330\u0325\u033E\u0365\u036C\u032D\u036C\u033B\u034D\u0320\u031C\u0353\u0329_\u032A_\u030A\u0300\u033F\u0361\u030C\u0303\u036F\u0309\u0339\u033B\u0368\u0318\u034C\u033C\u0305\u030D\u031A\u032B"
