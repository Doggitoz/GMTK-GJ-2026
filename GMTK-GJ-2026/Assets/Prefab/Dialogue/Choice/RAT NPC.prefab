--- !u!114 &4297962674975984462
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 240631433921496601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a433c9dfe9d7748d89a8ca1245488cff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestionDialogueTrigger
  introLines: []
  questionLines:
  - speaker: 1
    text: As a square is always a rectangle, but a rectangle is not always a square,
  - speaker: 1
    text: I am a monarch, a tyrant and am not good at length, in telling the age
      at which one might die, my measure is of other realms. What am I?
  choices:
  - A ruler
  - A wise king
  - A false prophet
  correctChoiceIndex: 0
  correctResponseLines:
  - speaker: 1
    text: For the ward, a reward! Choose your poison, choose it well, for you a secret
      I will tell!
  - speaker: 1
    text: And by I, We mean Kai, the only rat not forced to dictate to placate, in
      rhyme all the time.
  incorrectResponseLines:
  - speaker: 1
    text: Someone must be going mad, or your intellect truly was a fad?
  currencyReward: 10
  autoStartOnEnable: 0
