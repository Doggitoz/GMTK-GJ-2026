  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestionDialogueTrigger
  introLines: []
  questionLines:
  - speaker: 1
    text: A woman shoots her husband, then holds him underwater for five minutes.
      Next, she hangs him. Right after, they enjoy a lovely dinner. Explain.
  choices:
  - 'Obviously a resurrection spell. '
  - She dining with a corpse, mate.
  - "It\u2019s the development of a photo in a dark room."
  correctChoiceIndex: 2
  correctResponseLines:
  - speaker: 1
    text: For the ward, a reward! Choose your poison, choose it well, for you a secret
      I will tell!
  - speaker: 1
    text: And by I, We mean Kai, the only rat not forced to dictate to placate, in
      rhyme all the time.
  incorrectResponseLines:
  - speaker: 1
    text: Someone must be going mad, or your intellect truly was a fad?
  currencyReward: 10
  autoStartOnEnable: 0
