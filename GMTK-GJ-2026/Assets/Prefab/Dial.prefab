  m_Script: {fileID: 11500000, guid: 1725e93459a727743986bbdd861a2775, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogInteractable
  lines:
  - speaker: 0
    text: "Hey champ! Saw you out there running the course\u2026 making greaaaat
      time. "
  - speaker: 0
    text: "You\u2019re a real great sport, y\u2019know that?\r\n"
  - speaker: 0
    text: 'I see you have some serious respect for turtle kind, that totem?

'
  - speaker: 0
    text: "So\u2026I\u2019ve got an offer for you, as a single father, it\u2019s
      tough out here, maaan."
  - speaker: 0
    text: "Wanna like babysit, play with the kid for a little bit while you\u2019re
      out there on the clock face?\r\n"
  _randomlySelectSingleLine: 1
  OnDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
