--- !u!114 &6574802380366352864
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2243030033120032772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1725e93459a727743986bbdd861a2775, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogInteractable
  lines:
  - speaker: 0
    text: "Mannnnn, I know we\u2019re locked in like, a hell outside of time, but
      I have kids to feed. This is so lame."
  - speaker: 0
    text: "You seem almost as busy as me, and I\u2019m a single dad of fourty-three\u2026.
      Thousand\u2026."
  - speaker: 0
    text: "I\u2019m Dial, and this is my son, Dial, and my other son, Dial, and my
      other son, also Dial. "
  _randomlySelectSingleLine: 1
  OnDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
