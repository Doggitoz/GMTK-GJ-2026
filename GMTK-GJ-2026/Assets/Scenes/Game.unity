    - target: {fileID: 5452259664893453180, guid: d12792cc962d342f380112f94e63a521, type: 3}
      propertyPath: ItemDescription
      value: "\u201CWhat a cute turtle. I like tortols.\u201D\n\r\nYou get the feeling
        that using this will help you make more friends.\r\n"
      objectReference: {fileID: 0}
