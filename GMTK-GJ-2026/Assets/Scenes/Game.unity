    - target: {fileID: 4269288869135132065, guid: d12792cc962d342f380112f94e63a521, type: 3}
      propertyPath: ItemDescription
      value: "It\u2019s cracked\u2026 you didn\u2019t know divine bones could break.\n\r\nYou
        get the feeling that using this will hurt your legs\u2026.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4373160289748373666, guid: d12792cc962d342f380112f94e63a521, type: 3}
      propertyPath: ItemDescription
      value: "\u201CIt feels like a grape\u2026 or does a grape feel like an eye\u2026.\u201D\n\r\nYou
        get the feeling that using this will help you see hidden grime.\r\n"
      objectReference: {fileID: 0}
